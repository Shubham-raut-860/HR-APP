# =========================
# Backend Environment Template
# =========================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# Keep real secrets in `.env.local` or host-level environment variables.

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_CHAT_DEPLOYMENT=gpt-5.2-chat
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.2-chat
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Database
DATABASE_URL=sqlite+aiosqlite:///./hr_platform.db

# Auth / Security
SECRET_KEY=dev-local-only-secret-key-change-me-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=dev-local-only-encryption-key-change-me-32chars

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:5173

# Files
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_RESUME_EXTENSIONS=.pdf,.doc,.docx

# Scoring and Quiz
DEFAULT_RESUME_WEIGHT=50
DEFAULT_QUIZ_WEIGHT=50
DEFAULT_PASS_THRESHOLD=60
QUIZ_DURATION_MINUTES=30
QUIZ_TOTAL_QUESTIONS=20
QUIZ_EASY_COUNT=8
QUIZ_MEDIUM_COUNT=8
QUIZ_HARD_COUNT=4

# Langfuse (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# MLflow / evals
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=hr_evals
EVALS_ENABLED=false
ENABLE_METAFLOW=true

# Harness-inspired token monitoring
TOKEN_MONITOR_ENABLED=true
TOKEN_MONITOR_MAX_EVENTS=5000
TOKEN_MONITOR_DEFAULT_TOKEN_BUDGET=8000
TOKEN_MONITOR_WARN_MULTIPLIER=1.20
TOKEN_MONITOR_MAX_COST_USD_PER_CALL=0.25
TOKEN_MONITOR_TASK_BUDGETS_JSON={"parse_resume":12000,"score_resume":5000,"parse_jd_from_document":4000,"generate_jd":3500,"generate_quiz":7000,"normalize_skills":1500,"generate_hr_email":2000,"evaluate_code":2500,"enhance_resume":10000,"build_resume_from_form":7000,"generate_cover_letter":4500,"analyze_career_path":5000,"resume_to_builder_data":4500}

# Lyzr (optional)
LYZR_AGENT_ID=
LYZR_USER_ID=
LYZR_SESSION_ID=
LYZR_API_KEY=
LYZR_AGENT_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
