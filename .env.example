# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_REASONING_DEPLOYMENT=o4-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Database
DATABASE_URL=sqlite+aiosqlite:///./hr_platform.db
KYC_DATABASE_URL=sqlite+aiosqlite:///./candidate_kyc.db

# Auth
SECRET_KEY=your_jwt_secret_key_min_32_chars_here
ENCRYPTION_KEY=your_encryption_key_min_32_chars_here
HR_REGISTRATION_MODE=open
HR_INVITE_CODES=

# SMTP (email notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Redis (optional, required for production)
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Observability (optional)
LANGFUSE_ENABLED=false
DEEPEVAL_API_KEY=
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
